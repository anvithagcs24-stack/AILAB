        "import random\n",
        "import time\n",
        "\n",
        "class VacuumEnvironment:\n",
        "    def __init__(self):\n",
        "        # Locations A and B can be either 'Clean' or 'Dirty'\n",
        "        self.locations = {\n",
        "            \"A\": random.choice([\"Dirty\"]),\n",
        "            \"B\": random.choice([\"Dirty\"])\n",
        "        }\n",
        "        # Agent starts in a random location\n",
        "        self.agent_location = random.choice([\"A\"])\n",
        "        self.performance_score = 0\n",
        "\n",
        "    def get_percept(self):\n",
        "        \"\"\"Returns the current location and its condition.\"\"\"\n",
        "        return self.agent_location, self.locations[self.agent_location]\n",
        "\n",
        "    def execute_action(self, action):\n",
        "        \"\"\"Changes the environment state based on the agent's action.\"\"\"\n",
        "        print(f\" Agent decides to: {action}\")\n",
        "\n",
        "        if action == \"Suck\":\n",
        "            if self.locations[self.agent_location] == \"Dirty\":\n",
        "                self.locations[self.agent_location] = \"Clean\"\n",
        "                self.performance_score += 10  # Reward for cleaning\n",
        "                print(f\" Sucked dirt in Location {self.agent_location}.\")\n",
        "            else:\n",
        "                self.performance_score -= 1   # Penalty for wasting energy\n",
        "                print(f\" Tried to suck, but Location {self.agent_location} was already clean.\")\n",
        "\n",
        "        elif action == \"Move_Right\":\n",
        "            if self.agent_location == \"A\":\n",
        "                self.agent_location = \"B\"\n",
        "                print(\" Moved from A to B.\")\n",
        "            self.performance_score -= 1       # Energy cost for movement\n",
        "\n",
        "        elif action == \"Move_Left\":\n",
        "            if self.agent_location == \"B\":\n",
        "                self.agent_location = \"A\"\n",
        "                print(\"⬅ Moved from B to A.\")\n",
        "            self.performance_score -= 1       # Energy cost for movement\n",
        "\n",
        "    def display_status(self):\n",
        "        \"\"\"Prints the current state of the environment.\"\"\"\n",
        "        print(\"\\n\" + \"=\"*40)\n",
        "        print(f\" Agent Location: {self.agent_location}\")\n",
        "        print(f\" Status - Room A: {self.locations['A']} | Room B: {self.locations['B']}\")\n",
        "\n",
        "\n",
        "    def is_all_clean(self):\n",
        "        \"\"\"Checks if both locations are clean.\"\"\"\n",
        "        return self.locations[\"A\"] == \"Clean\" and self.locations[\"B\"] == \"Clean\"\n",
        "\n",
        "\n",
        "class ReflexVacuumAgent:\n",
        "    def __init__(self):\n",
        "        pass\n",
        "\n",
        "    def program(self, percept):\n",
        "        \"\"\"Reflex Agent rule logic: Condition -> Action\"\"\"\n",
        "        location, status = percept\n",
        "\n",
        "        if status == \"Dirty\":\n",
        "            return \"Suck\"\n",
        "        elif location == \"A\":\n",
        "            return \"Move_Right\"\n",
        "        elif location == \"B\":\n",
        "            return \"Move_Left\"\n",
        "\n",
        "\n",
        "# --- EXECUTION LOOP ---\n",
        "if __name__ == \"__main__\":\n",
        "    # Initialize the world and the agent\n",
        "    env = VacuumEnvironment()\n",
        "    agent = ReflexVacuumAgent()\n",
        "\n",
        "    print(\" Initializing Two-Location Vacuum Environment...\")\n",
        "    env.display_status()\n",
        "    time.sleep(1)\n",
        "\n",
        "    step = 1\n",
        "    # Run the simulation until both rooms are clean\n",
        "    while not env.is_all_clean() and step <= 5:\n",
        "        print(f\"\\n⏱ --- STEP {step} ---\")\n",
        "\n",
        "        # 1. Agent senses the environment (Percept)\n",
        "        percept = env.get_percept()\n",
        "        print(f\" Agent perceives: Location {percept[0]} is {percept[1]}\")\n",
        "\n",
        "        # 2. Agent chooses an action based on rules\n",
        "        action = agent.program(percept)\n",
        "\n",
        "        # 3. Environment reacts to the action\n",
        "        env.execute_action(action)\n",
        "\n",
        "        # 4. Show updated status\n",
        "        env.display_status()\n",
        "\n",
        "        step += 1\n",
        "        time.sleep(1.5)\n",
        "\n",
        "    if env.is_all_clean():\n",
        "        print(\"\\n Success! All locations are perfectly clean. \")\n",
        "    else:\n",
        "        print(\"\\n Simulation ended due to maximum steps reached.\")"
      ]
